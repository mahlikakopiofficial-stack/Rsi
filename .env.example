# TEMPLATE ONLY. Never put real credentials in GitHub.
# Supported modes: research (backtest) or paper (simulated execution). Live is not implemented.
APP_MODE=paper

# Bybit public market data (no API key required; paper_bot uses public endpoint only)
BYBIT_PUBLIC_BASE_URL=https://api.bybit.com
BYBIT_MARKET_DATA_DOCS_URL=https://bybit-exchange.github.io/docs/v5/market/kline
BYBIT_CATEGORY=linear
BYBIT_PAGE_LIMIT=100
HTTP_TIMEOUT_SECONDS=20
REQUEST_PAUSE_SECONDS=0.15

# Candle and RSI strategy
TIMEFRAME_MINUTES=5
RSI_PERIOD=20
LONG_ENTRY_CROSS_BELOW=40
LONG_EXIT_CROSS_ABOVE=70
SHORT_ENTRY_CROSS_ABOVE=85
SHORT_EXIT_CROSS_BELOW=30

# Research backtest date window. Leave dates blank to use BACKTEST_DAYS ending now (UTC).
BACKTEST_DAYS=90
BACKTEST_START_UTC=
BACKTEST_END_UTC=
MIN_CANDLES_REQUIRED=100

# Historical research assumptions (not live order sizing).
RESEARCH_NOTIONAL_USD=1000
FEE_RATE_PER_SIDE=0.00055
SLIPPAGE_RATE_PER_SIDE=0.0005

# Comma-separated Bybit linear symbols.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Historical backtest output directory.
BACKTEST_OUTPUT_DIR=reports

# Paper execution only. PAPER_NOTIONAL_USD is simulated per position; no real funds/orders.
PAPER_NOTIONAL_USD=5
PAPER_MAX_OPEN_POSITIONS=3
LOOP_SECONDS=10
PAPER_DB_PATH=data/paper_trading.sqlite3

# Optional Telegram alerts for paper bot. Keep actual credentials only in server .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Intentionally unused: private Bybit credentials are not used and live execution is absent.
BYBIT_API_KEY=
BYBIT_API_SECRET=
