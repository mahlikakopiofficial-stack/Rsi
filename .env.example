# TEMPLATE ONLY. Never put real credentials in GitHub.
# Historical research only; this project does not place orders.
APP_MODE=research

# Bybit public market data (no API key required)
BYBIT_PUBLIC_BASE_URL=https://api.bybit.com
BYBIT_MARKET_DATA_DOCS_URL=https://bybit-exchange.github.io/docs/v5/market/kline
BYBIT_CATEGORY=linear
BYBIT_PAGE_LIMIT=1000
HTTP_TIMEOUT_SECONDS=20
REQUEST_PAUSE_SECONDS=0.15

# Candle and RSI strategy
TIMEFRAME_MINUTES=5
RSI_PERIOD=20
LONG_ENTRY_CROSS_BELOW=40
LONG_EXIT_CROSS_ABOVE=70
SHORT_ENTRY_CROSS_ABOVE=85
SHORT_EXIT_CROSS_BELOW=30

# Backtest date window. Leave dates blank to use BACKTEST_DAYS ending now (UTC).
BACKTEST_DAYS=90
BACKTEST_START_UTC=
BACKTEST_END_UTC=
MIN_CANDLES_REQUIRED=100

# Historical estimates only; not an order size or trading recommendation.
# Applied per hypothetical completed trade, with no leverage.
RESEARCH_NOTIONAL_USD=1000
FEE_RATE_PER_SIDE=0.00055
SLIPPAGE_RATE_PER_SIDE=0.0005

# Separate symbol list; comma-separated Bybit linear symbols.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Output path, relative to repository root unless absolute.
BACKTEST_OUTPUT_DIR=reports

# These are intentionally unused by the public-data backtest.
# Do not provide them for historical data retrieval.
BYBIT_API_KEY=
BYBIT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
